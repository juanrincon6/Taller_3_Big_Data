############################## REDES NEURONALES ############################

# Limpiar entorno
rm(list = ls())
gc()
closeAllConnections()

# Cargar paquetes
if (!require("pacman")) install.packages("pacman")
library(pacman)

p_load(
  tidyverse, rio, keras, caret, Metrics
)

# Configurar rutas
user <- Sys.getenv("USERNAME")
if (user == "judel") {
  base_path <- "C:/Users/judel/OneDrive/Documentos/ANDES/Semestre 2/Big data/tercera parte/Taller 3/input"
} else if(user == "e125379") {
  base_path <- "C:\\Users\\e125379\\OneDrive - Mastercard\\8. Uniandes\\6. Big Data\\4. Taller 3\\1. Data\\"
} else if(user == "anamarrojas") {
  base_path <- "C:\\Users\\anamarrojas\\Downloads\\Taller 3\\1. Data\\"
}

store_path <- file.path(base_path, "stores")
pred_path  <- file.path(base_path, "predicciones")
dir.create(pred_path, recursive = TRUE, showWarnings = FALSE)

# Cargar datos
train <- readRDS(file.path(store_path, "train_full_final.rds"))
test  <- readRDS(file.path(store_path, "test_full_final.rds"))

# Imputación
Mode <- function(x) {
  ux <- unique(na.omit(x))
  ux[which.max(tabulate(match(x, ux)))]
}

train_clean_imputed <- train %>%
  mutate(across(where(is.numeric), ~ ifelse(is.na(.), mean(., na.rm = TRUE), .))) %>%
  mutate(across(where(is.factor), ~ ifelse(is.na(.), Mode(.), .))) %>%
  mutate(across(where(is.logical), ~ as.numeric(.)))

test_clean_imputed <- test %>%
  mutate(across(where(is.numeric), ~ ifelse(is.na(.), mean(., na.rm = TRUE), .))) %>%
  mutate(across(where(is.factor), ~ ifelse(is.na(.), Mode(.), .))) %>%
  mutate(across(where(is.logical), ~ as.numeric(.)))

# Fórmula con logprice
fmla <- logprice ~ surface_covered + rooms + bedrooms + bathrooms +
  property_type + tiene_remodelado + tiene_lujoso + tiene_bbq +
  tiene_balcon + tiene_terraza + tiene_vista + tiene_club_house +
  tiene_chimenea + distancia_parque + distancia_bus +
  distancia_avenida_principal + distancia_universidad +
  distancia_policia + distancia_restaurant + distancia_colegio

vars_modelo <- all.vars(fmla)
train_data <- train_clean_imputed %>% select(all_of(vars_modelo))
test_data <- test_clean_imputed %>% select(all_of(vars_modelo[-1]))  # sin logprice

# División entrenamiento / validación
set.seed(123)
split_idx <- createDataPartition(train_data$logprice, p = 0.8, list = FALSE)
train_set <- train_data[split_idx, ]
test_set  <- train_data[-split_idx, ]

# Preprocesamiento
keras <- function(df) {
  df %>%
    mutate(across(where(is.factor), ~ as.numeric(as.factor(.)))) %>%
    mutate(across(where(is.logical), ~ as.numeric(.)))
}

train_set <- keras(train_set)
test_set  <- keras(test_set)
test_data <- keras(test_data)

# Modelo simple
model_simple <- keras_model_sequential() %>%
  layer_dense(units = 64, activation = 'relu', input_shape = ncol(train_set) - 1) %>%
  layer_dense(units = 32, activation = 'relu') %>%
  layer_dense(units = 1)

model_simple %>% compile(
  loss = 'mse',
  optimizer = optimizer_adam(),
  metrics = c('mean_absolute_error')
)

history_simple <- model_simple %>% fit(
  as.matrix(train_set[, -which(names(train_set) == "logprice")]),
  train_set$logprice,
  epochs = 30,
  batch_size = 32,
  validation_data = list(
    as.matrix(test_set[, -which(names(test_set) == "logprice")]),
    test_set$logprice
  )
)

# Modelo complejo
model_complex <- keras_model_sequential() %>%
  layer_dense(units = 128, activation = 'relu', input_shape = ncol(train_set) - 1) %>%
  layer_dropout(rate = 0.3) %>%
  layer_dense(units = 64, activation = 'relu') %>%
  layer_dropout(rate = 0.3) %>%
  layer_dense(units = 32, activation = 'relu') %>%
  layer_dense(units = 1)

model_complex %>% compile(
  loss = 'mse',
  optimizer = optimizer_adam(),
  metrics = c('mean_absolute_error')
)

early_stop <- callback_early_stopping(monitor = "val_loss", patience = 10, restore_best_weights = TRUE)

history_complex <- model_complex %>% fit(
  as.matrix(train_set[, -which(names(train_set) == "logprice")]),
  train_set$logprice,
  epochs = 100,
  batch_size = 64,
  validation_data = list(
    as.matrix(test_set[, -which(names(test_set) == "logprice")]),
    test_set$logprice
  ),
  callbacks = list(early_stop)
)

# Predicciones sobre test
y_hat_simple <- exp(predict(model_simple, as.matrix(test_data)))
y_hat_complex <- exp(predict(model_complex, as.matrix(test_data)))

# Exportar predicciones
submission_simple <- test %>% select(property_id)
submission_simple$price <- round(as.vector(y_hat_simple))
write_csv(submission_simple, file.path(pred_path, "submission_nn_simple.csv"))

submission_complex <- test %>% select(property_id)
submission_complex$price <- round(as.vector(y_hat_complex))
write_csv(submission_complex, file.path(pred_path, "submission_nn_complex.csv"))

# Evaluación en validación
val_x <- as.matrix(test_set[, -which(names(test_set) == "logprice")])
val_y <- exp(test_set$logprice)

pred_simple <- exp(predict(model_simple, val_x))
pred_complex <- exp(predict(model_complex, val_x))

mae_simple <- mae(val_y, pred_simple)
rmse_simple <- rmse(val_y, pred_simple)
r2_simple <- 1 - sum((val_y - pred_simple)^2) / sum((val_y - mean(val_y))^2)
mape_simple <- mape(val_y, pred_simple)

mae_complex <- mae(val_y, pred_complex)
rmse_complex <- rmse(val_y, pred_complex)
r2_complex <- 1 - sum((val_y - pred_complex)^2) / sum((val_y - mean(val_y))^2)
mape_complex <- mape(val_y, pred_complex)

# Tabla de métricas
tabla_metricas <- data.frame(
  Métrica = c("MAE", "RMSE", "R²", "MAPE"),
  Modelo_Simple = c(mae_simple, rmse_simple, r2_simple, mape_simple),
  Modelo_Complejo = c(mae_complex, rmse_complex, r2_complex, mape_complex)
)

tabla_metricas <- tabla_metricas %>%
  mutate(across(where(is.numeric), ~ round(., 4)))

write.csv(tabla_metricas, file.path(pred_path, "tabla_metricas_modelos_nn.csv"), row.names = FALSE)
